<?xml version="1.0"?>

<launch>
    <arg name="robot_name" default="$(optenv TIANRACER_NAME tianracer)" doc="robot name [tianracer_No1, tianracer_No2, tianracer_No3, ...]"/>
    <arg name="use_rviz" default="false" />
    <arg name="fixed_frame" default="$(arg robot_name)/base_footprint"/>
    <arg name="mode" default="right_wall" />
    <arg name="speed" default="0.5" />
    <arg name="max_steering_angle" default="0.5" />
    <arg name="target_distance" default="0.6" />
    <arg name="steering_gain" default="0.8" />

    <node ns="$(arg robot_name)" pkg="tianracer_navigation" type="wall_following.py" name="wall_following" output="screen">
        <param name="robot_name" value="$(arg robot_name)" />
        <param name="marker_frame" value="$(arg robot_name)/base_footprint" />
        <param name="mode" value="$(arg mode)" />
        <param name="speed" value="$(arg speed)" />
        <param name="max_steering_angle" value="$(arg max_steering_angle)" />
        <param name="target_distance" value="$(arg target_distance)" />
        <param name="steering_gain" value="$(arg steering_gain)" />
    </node>
    <node ns="$(arg robot_name)" pkg="tianracer_navigation" type="ackermann_convert_drive.py" name="ackermann_convert_drive" output="screen" />

    <node ns="$(arg robot_name)" pkg="rviz" type="rviz" name="rviz" args="-d $(find tianracer_rviz)/rviz_cfg/wall_following_debug_with_amcl.rviz -f $(arg fixed_frame)" if="$(arg use_rviz)" />
</launch>
